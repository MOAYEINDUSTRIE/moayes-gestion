        ".read": "(auth != null && auth.provider == 'password' && auth.token.email == 'moayepos@gmail.com') || (auth != null && auth.provider == 'password' && root.child('moayes/v2_comptes/'+auth.uid+'/actif').val() === true)",
        ".write": "(auth != null && auth.provider == 'password' && auth.token.email == 'moayepos@gmail.com') || (auth != null && auth.provider == 'password' && root.child('moayes/v2_comptes/'+auth.uid+'/actif').val() === true)"
      },
