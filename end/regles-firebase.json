        ".read": "(auth != null && root.child('end/roles/'+auth.uid+'/actif').val() === true && (root.child('end/roles/'+auth.uid+'/role').val() === 'admin' || root.child('end/roles/'+auth.uid+'/role').val() === 'tresorier' || root.child('end/roles/'+auth.uid+'/role').val() === 'adjointe' || root.child('end/roles/'+auth.uid+'/role').val() === 'cac' || root.child('end/roles/'+auth.uid+'/role').val() === 'gm'))",
        "$id": {
