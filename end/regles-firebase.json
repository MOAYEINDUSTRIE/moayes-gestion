          ".validate": "newData.hasChildren(['nom','email','role','actif']) && newData.child('actif').isBoolean() && newData.child('role').isString() && newData.child('role').val().matches(/^(directrice|vendeur|comptable|producteur)$/)"
        }
      }
    },
    "end": {
