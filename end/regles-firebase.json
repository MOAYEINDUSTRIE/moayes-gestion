          ".validate": "newData.hasChildren(['num','date','montant','de','vers','saisiPar']) && newData.child('montant').isNumber() && newData.child('de').val() !== newData.child('vers').val() && (newData.child('supprime').val() !== true || newData.child('motif').val().length >= 5)"
        }
