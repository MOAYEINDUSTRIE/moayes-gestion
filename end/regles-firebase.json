        ".read": "(auth != null && root.child('end/roles/'+auth.uid+'/actif').val() === true && (root.child('end/roles/'+auth.uid+'/role').val() === 'admin' || root.child('end/roles/'+auth.uid+'/role').val() === 'tresorier' || root.child('end/roles/'+auth.uid+'/role').val() === 'adjointe' || root.child('end/roles/'+auth.uid+'/role').val() === 'cac' || root.child('end/roles/'+auth.uid+'/role').val() === 'gm'))",
        "$id": {
          ".write": "newData.exists() && ((auth != null && root.child('end/roles/'+auth.uid+'/actif').val() === true && (root.child('end/roles/'+auth.uid+'/role').val() === 'admin' || root.child('end/roles/'+auth.uid+'/role').val() === 'tresorier')) || ((auth != null && root.child('end/roles/'+auth.uid+'/actif').val() === true && (root.child('end/roles/'+auth.uid+'/role').val() === 'adjointe')) && newData.child('supprime').val() !== true && newData.child('saisiPar').val() === auth.uid && (!data.exists() || data.child('saisiPar').val() === auth.uid)))",
          ".validate": "newData.hasChildren(['recu','date','code','montant','devise','taux','fcfa','saisiPar']) && newData.child('fcfa').isNumber() && (newData.child('supprime').val() !== true || newData.child('motif').val().length >= 5)"
