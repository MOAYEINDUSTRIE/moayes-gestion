        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "(auth != null && root.child('end/roles/'+auth.uid+'/actif').val() === true && (root.child('end/roles/'+auth.uid+'/role').val() === 'admin')) || (auth != null && auth.uid === $uid && !data.exists() && auth.token.email === 'moayepos@gmail.com' && newData.child('role').val() === 'admin')",
